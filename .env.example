# Local development environment for ocrapi.
# Copy to .env and fill in your values.

# --- GCP Document AI ---
GCP_PROJECT_ID=your-gcp-project
GCP_LOCATION=us
GCP_PROCESSOR_ID=your-processor-id
GOOGLE_APPLICATION_CREDENTIALS=./gcp-credentials.json

# --- Cloud Storage (batch OCR scratch; unused by current async jobs) ---
GCS_BUCKET=your-gcp-project-ocrapi-batch
BATCH_TIMEOUT_SECONDS=1800
BATCH_POLL_INTERVAL_SECONDS=10

# --- Google Drive (optional server default for /v1/jobs and /v1/jobs/{jobId}/drive) ---
# DRIVE_SHARED_FOLDER_ID=your-shared-drive-folder-id

# --- API limits ---
MAX_UPLOAD_BYTES=629145600
MAX_PDF_PAGES=2000

# --- Chunked online OCR (sync /v1/ocr and async jobs) ---
ONLINE_CHUNK_PAGES=15
ONLINE_CHUNK_MAX_BYTES=18874368
ONLINE_MAX_CONCURRENCY=8

# --- PyMuPDF text-layer assembly ---
PDF_SAVE_INCREMENTAL=true
PDF_USE_TEXTWRITER=true

# --- Storage ---
JOBS_DIR=jobs
OCR_WORKER_CONCURRENCY=2

# --- Server ---
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
