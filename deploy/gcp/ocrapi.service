[Unit]
Description=ocrapi (FastAPI + Document AI batch + PyMuPDF)
Documentation=https://github.com/your-org/ocrapi
Wants=network-online.target docker.service
After=network-online.target docker.service data.mount
# Hard dependency, not just ordering: if the data disk fails to mount, refuse
# to start instead of silently writing the TLS cert and job dirs to the boot
# disk (where they would not survive a VM rebuild).
RequiresMountsFor=/data

[Service]
# /etc/ocrapi.image is written by 04-run.sh and pins the exact image tag, e.g.
#   IMAGE=us-central1-docker.pkg.dev/PROJECT/ocrapi/ocrapi:2026-06-07-abc1234
EnvironmentFile=/etc/ocrapi.image

Restart=on-failure
RestartSec=5s
TimeoutStartSec=600
TimeoutStopSec=120

# Always start from a clean slate so env / image changes take effect.
ExecStartPre=-/usr/bin/docker rm -f ocrapi
ExecStartPre=/usr/bin/docker pull ${IMAGE}

# TLS terminates in uvicorn: the cert dir is mounted read-only and the image's
# plain-HTTP CMD is overridden with --ssl-* flags. Cert is generated by
# 02-vm-setup.sh at /data/tls. Single worker preserved (JobManager owns an
# in-process asyncio queue; extra workers would break the bounded pool).
ExecStart=/usr/bin/docker run --rm --name ocrapi \
  --env-file /etc/ocrapi.env \
  -v /data/jobs:/data/jobs \
  -v /data/tls:/certs:ro \
  -p 0.0.0.0:8000:8000 \
  --log-driver=journald \
  --log-opt tag=ocrapi \
  ${IMAGE} \
  uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 1 \
  --ssl-keyfile /certs/key.pem --ssl-certfile /certs/cert.pem

ExecStop=/usr/bin/docker stop -t 60 ocrapi

[Install]
WantedBy=multi-user.target
