# Production environment for ocrapi running on the GCE VM.
# Copy to /etc/ocrapi.env on the VM and chmod 600.
#
# IMPORTANT: GOOGLE_APPLICATION_CREDENTIALS is intentionally UNSET.
# google-auth picks up the attached VM service account via Application Default
# Credentials. This avoids baking key files into the container image.

# --- GCP Document AI ---
GCP_PROJECT_ID=anda-dev-457721
GCP_LOCATION=us
GCP_PROCESSOR_ID=bdc855592c76c7c

# --- Cloud Storage (Document AI batch scratch) ---
GCS_BUCKET=anda-dev-457721-ocrapi-batch
BATCH_TIMEOUT_SECONDS=1800
BATCH_POLL_INTERVAL_SECONDS=10

# --- Google Drive (Shared Drive folder must be shared with ocrapi-sa@...) ---
DRIVE_SHARED_FOLDER_ID=1fh9BC3leRRMUIcwPrTJETtKTjLfA4MpZ

# --- API limits ---
MAX_UPLOAD_BYTES=734003200
MAX_PDF_PAGES=2000
SYNC_MAX_PAGES=15

# --- Storage paths (mounted from the data Hyperdisk at /data) ---
JOBS_DIR=/data/jobs

# --- Concurrency tuned for c4-standard-4 (4 vCPU / 15 GB RAM) ---
# Batch LRO polling is I/O-bound; several concurrent jobs can share the VM.
OCR_WORKER_CONCURRENCY=4

# --- Server ---
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
